# === Sekrety — NIGDY do repo ===
.env
.env.*
!.env.example
*.key
*.pem
# Sesja Facebooka dla wyszukiwarki grup (FB_COOKIES_PATH, patrz
# scripts/znajdz_grupy.py). Plik ma leżeć POZA repo — te wzorce są zabezpieczeniem
# na wypadek, gdyby ktoś mimo to upuścił go tutaj. Zacommitowana sesja to
# zalogowane konto operatora w historii gita, a historii się nie cofa.
*cookies*.json
*ciasteczka*.json

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
build/
dist/

# === Stan maszyny, nie kod ===
# Indeks ostatnio działającego klucza APIFY_API_TOKEN{N} — per środowisko,
# patrz laweta_radar/workers/apify_keys.py.
.apify_key_state
# Pula proxy: żyje godziny i każdy VPS ma własną. Nie ma czego commitować.
.apify_proxy_pool.json
.apify_proxy_pool.json.tmp
# Obrazki tras pod alertami (services/mapa.py). Kafelki są cudze i pobrane,
# a wpisy same kasują się po 7 dniach — to stan maszyny, nie kod.
laweta_radar/.mapy_cache/
# Ślad po przerwanym zapisie data/kandydaci_grupy.csv (zapis jest atomowy: tmp
# + podmiana nazwy, patrz scripts/znajdz_grupy.py). SAM plik .csv jest
# wersjonowany świadomie — siedzi w nim ręczna weryfikacja grup, patrz data/README.md.
data/*.csv.tmp

# === Logi ===
*.log
logs/

# === IDE / system ===
.vscode/
.idea/
*.swp
.DS_Store
