# Panel czyta ze środowiska JEDNĄ zmienną. Reszta konfiguracji siedzi po stronie
# API (laweta_radar/.env) i to jest celowe: dwa pliki z tymi samymi progami
# rozjeżdżają się przy pierwszej zmianie, a wtedy panel pokazuje inne liczby niż
# alert na Telegramie.
#
#   cp panel/.env.example panel/.env.local

# Gdzie stoi FastAPI. Panel proxuje do niego przez rewrite `/api/*` (patrz
# next.config.ts), więc przeglądarka widzi jedno źródło i CORS w ogóle nie
# wchodzi w grę — a CORS na telefonie objawia się pustym ekranem bez komunikatu.
LAWETA_API_URL=http://127.0.0.1:8002

# TOKENU TU NIE MA i nie powinno być. `API_TOKEN` operator wkleja raz w samej
# aplikacji (zapisuje się w localStorage tego telefonu). Wpisany tutaj wszedłby
# do bundla, czyli byłby czytelny dla każdego, kto otworzy adres panelu.
