# =============================================================================
# LAWETA RADAR — wzór konfiguracji. Skopiuj i uzupełnij:
#   cp laweta_radar/.env.example laweta_radar/.env
#
# ZASADA W CAŁYM REPO: brak zmiennej = worker kończy CZYSTO z komunikatem, nigdy
# wyjątkiem. Możesz więc wypełniać ten plik po kawałku — system po prostu robi
# tyle, ile umie, i mówi, czego mu brakuje:
#   bash laweta_radar/scripts/check_setup.sh
# =============================================================================

# --- BAZA -------------------------------------------------------------------
# OSOBNA baza `laweta` (nie współdzielona z innymi projektami). Rola z tego DSN-a
# NIE potrzebuje praw DDL — tabele zakłada migracja odpalana ręcznie.
DATABASE_URL=postgresql://laweta:haslo@localhost:5432/laweta
# Rola z prawami DDL, TYLKO do migracji (scripts/migrate.sh). Na produkcji podaj
# ją jawnie — jeśli DATABASE_URL workera ma prawa DDL, rozdział ról nie istnieje.
DATABASE_URL_ADMIN=

# --- KLASYFIKATOR (Anthropic) -----------------------------------------------
ANTHROPIC_API_KEY=
# Haiku wystarcza do decyzji "zlecenie na lawetę czy nie" i jest kilkanaście razy
# tańszy od modeli większych. Podmieniaj, gdy jakość decyzji przestanie wystarczać.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# --- TELEGRAM (jedyny kanał dowozu do operatora) ----------------------------
# Token od @BotFather. CHAT_ID: napisz coś do bota i odczytaj z
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Brak tych dwóch = alerty wyciszone, ale zbieranie postów działa dalej.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Test dowozu z TEJ maszyny:  python -m laweta_radar.services.telegram_notify

# --- ZASIĘG LAWETY ----------------------------------------------------------
# Współrzędne bazy — punkt, od którego liczymy dystans do zdarzenia. Bez tego nie
# da się odrzucić zlecenia z drugiego końca Polski, a takie zlecenie jest gorsze
# niż brak zlecenia: zjada uwagę operatora, który i tak po nie nie pojedzie.
# Skopiuj z Map Google (przecinek dziesiętny jest OK).
BAZA_LAT=
BAZA_LON=
MAX_DYSTANS_KM=80
# Po ilu godzinach post jest już nieaktualny. Zlecenie na lawetę żyje
# kilkadziesiąt minut — po dobie ktoś już przyjechał, a my płacimy Apify za
# pobranie i modelowi za klasyfikację czegoś, co jest nieaktualne.
MAX_WIEK_POSTA_H=12

# =============================================================================
# APIFY — scrapowanie grup FB
# =============================================================================
# Brak tokenu => fetcher wypisuje komunikat i kończy CZYSTO (nic nie pobiera,
# nie wywala crona). System jest gotowy, ale NIEAKTYWNY do czasu:
#   token TUTAJ + grupy w config/groups.py (status "ok") + migracje odpalone.
#
# ROTACJA KLUCZY (pula darmowych kont, ~5 USD/mies. każde): zamiast jednego
# tokenu możesz podać WIELE — APIFY_API_TOKEN1, APIFY_API_TOKEN2, ... (numeracja
# od 1, CIĄGŁA, dowolnie wiele). Fetcher używa pierwszego, a gdy klucz wyczerpie
# kredyt, REAKTYWNIE przeskakuje na następny (workers/apify_keys.py).
# Podgląd wykrytych kluczy:  python -m laweta_radar.workers.apify_keys
# Stary APIFY_API_TOKEN (bez numeru) działa jako pojedynczy klucz (fallback).
APIFY_API_TOKEN1=
APIFY_API_TOKEN2=
APIFY_API_TOKEN=

# --- PROXY dla ruchu do Apify -----------------------------------------------
# Po co: pula kont Apify wychodząca z JEDNEGO IP VPS-a wygląda dla Apify jak
# podręcznikowy multi-accounting — i tracisz całą pulę naraz, nie jedno konto.
# Każde konto dostaje własne, STAŁE wyjście. Pełna instrukcja z dostawcami
# i kosztami: docs/APIFY-PROXY.md
#
# Sposób 1 — BRAMA Z SESJĄ LEPKĄ (najlepszy przy dużej puli, jeden wpis):
#   {session} podmieniamy na stały identyfikator liczony z tokenu, więc konto ma
#   inne, ale ZAWSZE TO SAMO wyjście. Format loginu bierzesz z panelu dostawcy.
#   APIFY_PROXY_URL=http://klient-session-{session}:haslo@gw.dostawca.com:7000
APIFY_PROXY_URL=
#
# Sposób 2 — PULA PROXY (lista adresów; przecinek, średnik albo nowa linia).
#   Zakres portów działa u dostawców "port = sesja":
#   APIFY_PROXY_URLS=http://user:haslo@gw.dostawca.com:10001-10100
APIFY_PROXY_URLS=
#
# Sposób 3 — proxy przypisane WPROST do klucza o tym numerze (APIFY_PROXY{N} pod
# APIFY_API_TOKEN{N}). Najwyższy priorytet; sensowne przy kilku kontach.
#   APIFY_PROXY1=http://user:haslo@1.2.3.4:8000
#
# Sposób 4 — pula z PLIKU. W tym repo plik jest wejściem ZEWNĘTRZNYM (generatora
# darmowej puli świadomie nie przenieśliśmy — patrz docs/APIFY-PROXY.md), więc
# musisz go dostarczyć sam. Domyślnie WYŁĄCZONE i tak ma zostać, dopóki nie masz
# czym go odświeżać: pula, której nikt nie odświeża, jest GORSZA niż jej brak —
# jeden żywy wpis przejmuje KOMPLET kont i wszystko idzie w timeouty.
#   APIFY_PROXY_POOL=1            włącz czytanie pliku puli
#   APIFY_PROXY_POOL_FILE=        ścieżka (domyślnie laweta_radar/.apify_proxy_pool.json)
#   APIFY_PROXY_POOL_MAX_AGE_H=6  po ilu godzinach pula jest STARA (ostrzeżenie w logu)
APIFY_PROXY_POOL=0
#
# Znaki specjalne w loginie/haśle koduj procentowo (@ : / ? # %).
# Hasło `p@ss:word` zapisujesz jako `p%40ss%3Aword` — niezakodowane `@` rozjeżdża
# parsowanie adresu i ruch pójdzie nie tam, gdzie miał.
#
# BEZPIECZNIK: 1 = bez działającego proxy workery Apify kończą CZYSTO, zamiast
# wychodzić z gołego IP VPS-a. Zły URL proxy zatrzymuje run ZAWSZE, niezależnie
# od tej flagi.
APIFY_PROXY_REQUIRED=0
#
# Sprawdzenie, czy naprawdę działa:
#   python -m laweta_radar.workers.apify_proxy            # przypisanie, bez sieci
#   python -m laweta_radar.workers.apify_proxy --check    # REALNE IP per konto
